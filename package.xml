<package format="3">
  <name>grasp_synergy_adapter</name>
  <version>0.1.0</version>
  <description>Map low-dimensional grasp synergies to configurable multi-joint hand trajectories.</description>
  <maintainer email="shkwon098@gmail.com">Sunghyun Kwon</maintainer>
  <license file="LICENSE">Apache-2.0</license>
  <author email="shkwon098@gmail.com">Sunghyun Kwon</author>
  <url type="repository">https://github.com/shkwon98/grasp_synergy_adapter</url>
  <url type="bugtracker">https://github.com/shkwon98/grasp_synergy_adapter/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>control_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
